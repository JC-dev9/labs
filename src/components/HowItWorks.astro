<section id="como" data-how>
  <div class="container section-pad how" data-how-inner>
    <div class="section-head">
      <h2 class="h2" data-split>Como funciona</h2>
      <span class="sub" data-reveal>Três passos. Qualquer conhecimento.</span>
    </div>
    <div class="how-progress" aria-hidden="true"><span data-how-bar></span></div>
    <div class="steps">
      <div class="step" data-step>
        <div class="step-visual files" aria-hidden="true">
          <div class="file" data-piece><i></i>Manual de procedimentos.pdf</div>
          <div class="file" data-piece><i></i>Formação comercial</div>
          <div class="file add" data-piece>+ adicionar fonte</div>
        </div>
        <div class="step-copy"><span class="step-num">01</span><span class="step-title">Junte o seu conhecimento</span><span class="step-text">Documentos, manuais e conteúdos que já existem.</span></div>
      </div>
      <div class="step" data-step>
        <div class="step-visual" aria-hidden="true">
          <div class="chips"><span data-piece>Férias</span><span data-piece>Despesas</span><span class="on" data-piece>Integração</span></div>
          <div class="tree"><span data-piece>Primeiro dia</span><span data-piece>Ferramentas</span><span data-piece>Contactos da equipa</span></div>
        </div>
        <div class="step-copy"><span class="step-num">02</span><span class="step-title">A BeLight organiza</span><span class="step-text">Tudo ganha estrutura, contexto e ligação.</span></div>
      </div>
      <div class="step" data-step>
        <div class="step-visual" aria-hidden="true">
          <div class="mini-q" data-piece>Sou novo. Por onde começo?</div>
          <div class="typing" data-typing><i></i><i></i><i></i></div>
          <div class="mini-a" data-piece data-late>Preparei um percurso para a sua função. Primeiro passo: as ferramentas da equipa.</div>
        </div>
        <div class="step-copy"><span class="step-num">03</span><span class="step-title">Cada pessoa recebe o que precisa</span><span class="step-text">Respostas, explicações e percursos à medida.</span></div>
      </div>
    </div>
  </div>
</section>

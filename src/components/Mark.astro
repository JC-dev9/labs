---
// BeLight mark: the pillar and the rising light.
interface Props { width: number; height: number; class?: string }
const { width, height, class: cls } = Astro.props;
---
<svg class={cls} width={width} height={height} viewBox="0 0 42 48" aria-hidden="true">
  <rect x="4" y="4" width="10" height="40" fill="#F6F5F2" />
  <circle class="mark-sun" cx="26" cy="32" r="12" fill="#F4C95D" />
</svg>

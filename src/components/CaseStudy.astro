---
import { Image } from "astro:assets";
import logo from "../assets/belight-bible-logo.png";
import web from "../assets/web.png";
import appChat from "../assets/app-chat.png";
---
<section id="caso" class="case" data-case>
  <div class="container section-pad">
    <div class="section-head">
      <div class="case-intro">
        <div class="case-badge" data-reveal><Image src={logo} alt="BeLight Bible" width={36} height={36} densities={[1, 2]} /><b>BeLight Bible</b><em>Caso 01</em></div>
        <h2 class="h2" data-split>Começámos por um dos textos mais complexos que existem.</h2>
      </div>
      <a href="https://belight-bible.vercel.app/" target="_blank" rel="noopener" class="btn btn-outline" data-reveal data-magnetic>Abrir a aplicação <span class="arr" aria-hidden="true">↗</span></a>
    </div>
    <div class="showcase" data-showcase>
      <div class="browser" data-browser>
        <div class="browser-bar"><i></i><i></i><i></i><span>belight-bible.vercel.app</span></div>
        <Image src={web} alt="BeLight Bible na web" widths={[960, 1440, 1920, 2880]} sizes="(min-width: 1240px) 960px, 90vw" quality={88} loading="lazy" />
      </div>
      <div class="phone" data-phone><Image src={appChat} alt="Perguntas na app" widths={[300, 520]} sizes="(min-width: 1240px) 250px, 20vw" loading="lazy" /></div>
    </div>
    <div class="features" data-stagger>
      <div class="feature"><b>Lê</b><span>Leitura guiada, ao ritmo de cada pessoa.</span></div>
      <div class="feature"><b>Pergunta</b><span>Respostas claras, com a passagem como fonte.</span></div>
      <div class="feature"><b>Percebe</b><span>Contexto histórico explicado de forma simples.</span></div>
    </div>
  </div>
</section>
